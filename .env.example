# ── API 基地址（服务端 SSR 直连后端用） ──
# 对应 nuxt.config.ts runtimeConfig.apiBase。private 键的覆盖前缀是 NUXT_（不是 NUXT_PUBLIC_）。
# 本地 http://localhost:3001；测试/生产填后端内网或公网可达地址（如 https://api.xxx.com）。
# 客户端浏览器不读此值——走同源 /api（dev 用 nitro.devProxy，生产用反代），无需配置。
NUXT_API_BASE="http://localhost:3001"

# 如需向客户端暴露变量，用 NUXT_PUBLIC_ 前缀，例如：
# NUXT_PUBLIC_SITE_NAME="论坛"
